{
	"name": "vimium-plus",
	"version": "0.3.0",
	"description": "Vimium-style keyboard navigation for Obsidian.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"obsidian",
		"vim",
		"vimium",
		"keyboard"
	],
	"author": "Stian Lyng",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^20.11.0",
		"@typescript-eslint/eslint-plugin": "^6.15.0",
		"@typescript-eslint/parser": "^6.15.0",
		"esbuild": "^0.28.2",
		"obsidian": "^1.4.11",
		"tslib": "^2.6.2",
		"typescript": "^5.3.3"
	}
}
